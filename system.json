{
  "id": "carl-rpg",
  "title": "Dungeon Crawler Carl RPG",
  "description": "A Foundry VTT system for the Dungeon Crawler Carl Roleplaying Game.",
  "version": "1.0.15",
  "url": "https://github.com/shinierball/carlrpg",
  "manifest": "https://raw.githubusercontent.com/shinierball/carlrpg/main/system.json",
  "download": "https://github.com/shinierball/carlrpg/archive/refs/heads/main.zip",
  "compatibility": {
    "minimum": "12",
    "verified": "12",
    "maximum": "14"
  },
  "authors": [
    {
      "name": "DCC RPG Community"
    }
  ],
  "esmodules": [
    "src/dcc.mjs"
  ],
  "styles": [
    "styles/dcc.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "grid": {
    "distance": 5,
    "units": "ft"
  },
  "primaryTokenAttribute": "attributes.hp",
  "packs": [
    {
      "name": "skills",
      "label": "DCC Skills",
      "path": "packs/skills",
      "type": "Item",
      "system": "carl-rpg",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "spells",
      "label": "DCC Spells",
      "path": "packs/spells",
      "type": "Item",
      "system": "carl-rpg",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "buffs",
      "label": "DCC Buffs & Debuffs",
      "path": "packs/buffs",
      "type": "Item",
      "system": "carl-rpg",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    }
  ],
  "flags": {
    "hotReload": {
      "extensions": [
        "css",
        "hbs",
        "html",
        "json",
        "mjs"
      ],
      "paths": [
        "styles",
        "templates",
        "lang",
        "src"
      ]
    }
  }
}
