<form class="{{cssClass}} dcc-sheet" autocomplete="off">
  {{!-- Modern 5-Tab Navigation --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="page1"><i class="fa-solid fa-address-card"></i> 1: Core &amp; Combat</a>
    <a class="item" data-tab="page4"><i class="fa-solid fa-shield-halved"></i> 2: Equipment &amp; Inventory</a>
    <a class="item" data-tab="page3"><i class="fa-solid fa-bolt"></i> 3: Skills &amp; Spells</a>
    <a class="item" data-tab="conditions"><i class="fa-solid fa-shield-virus"></i> 4: Conditions &amp; Effects</a>
    <a class="item" data-tab="story"><i class="fa-solid fa-book-open"></i> 5: Story &amp; Sponsors</a>
    <a class="item" data-tab="achievements"><i class="fa-solid fa-trophy"></i> 6: Achievements</a>
  </nav>

  {{!-- Sheet Content --}}
  <section class="sheet-body">
    {{!-- Tab 1: Core & Combat --}}
    <div class="tab page1" data-group="primary" data-tab="page1">
      {{> "systems/carl-rpg/templates/actors/parts/page1-core.hbs"}}
    </div>

    {{!-- Tab 2: Equipment & Inventory --}}
    <div class="tab page4" data-group="primary" data-tab="page4">
      {{> "systems/carl-rpg/templates/actors/parts/page4-inventory.hbs"}}
    </div>

    {{!-- Tab 3: Skills & Spells (Unified Abilities & Magic) --}}
    <div class="tab page3" data-group="primary" data-tab="page3">
      {{> "systems/carl-rpg/templates/actors/parts/page3-skills.hbs"}}
      <div class="dcc-spells-section" data-tab="spells" style="margin-top: 14px;">
        {{> "systems/carl-rpg/templates/actors/parts/spells.hbs"}}
      </div>
    </div>

    {{!-- Tab 4: Conditions & Effects --}}
    <div class="tab conditions" data-group="primary" data-tab="conditions">
      {{> "systems/carl-rpg/templates/actors/parts/conditions.hbs"}}
    </div>

    {{!-- Tab 5: Story & Sponsors --}}
    <div class="tab story" data-group="primary" data-tab="story">
      {{> "systems/carl-rpg/templates/actors/parts/story-extras.hbs"}}
    </div>

    {{!-- Tab 6: Achievements --}}
    <div class="tab achievements" data-group="primary" data-tab="achievements">
      {{> "systems/carl-rpg/templates/actors/parts/achievements.hbs"}}
    </div>
  </section>
</form>
