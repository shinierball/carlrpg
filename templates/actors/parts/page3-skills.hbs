{{!-- PAGE 3: SKILLS --}}
<div class="dcc-page-container">
  <div class="dcc-stat-block">
    <div class="dcc-banner-header">
      <span>SKILLS</span>
      <div style="display: flex; gap: 12px; align-items: center;">
        <a class="open-skill-picker" data-tooltip="Choose from official DCC Skill Library" style="color: #f1c40f; cursor: pointer; font-size: 13px; font-weight: normal; text-transform: none;">
          <i class="fa-solid fa-book-bookmark"></i> Select Skill
        </a>
        <a class="item-create" data-type="skill" data-tooltip="Create a custom skill" style="color: #fff; cursor: pointer; font-size: 13px; font-weight: normal; text-transform: none;">
          <i class="fa-solid fa-plus"></i> Custom Skill
        </a>
      </div>
    </div>

    <table class="dcc-attacks-table dcc-skills-table">
      <thead>
        <tr>
          <th style="width: 25%;">Skill Name</th>
          <th style="width: 8%;" title="Rank 0 = Untrained (Disadvantage)">Rank</th>
          <th style="width: 15%;">Stat & Mod</th>
          <th style="width: 15%;">Check Type</th>
          <th style="width: 25%;">Notes & Upgrades</th>
          <th style="width: 12%;">Roll / Actions</th>
        </tr>
      </thead>
      <tbody>
        {{#each skills as |skill|}}
          <tr data-item-id="{{skill.id}}" style="{{#if skill.isGranted}}background: #fdf5e6;{{/if}}">
            <td>
              <div style="display: flex; align-items: center; gap: 6px;">
                <img src="{{skill.img}}" style="width: 20px; height: 20px; border: 1px solid #333; border-radius: 3px; object-fit: contain; background: #222;" />
                {{#if skill.isGranted}}
                  <span style="font-weight: bold; flex: 1;" title="Granted by: {{skill.itemSources}}">{{skill.name}}</span>
                  <span class="dcc-badge" style="background: #e67e22; color: #fff; font-size: 9px; padding: 1px 4px; border-radius: 2px;" title="Granted by: {{skill.itemSources}}">GEAR</span>
                {{else}}
                  <input class="dcc-field-input item-inline-edit" type="text" data-field="name" value="{{skill.name}}" style="font-weight: bold; flex: 1;" />
                {{/if}}
              </div>
            </td>
            <td>
              {{#if skill.isGranted}}
                <span class="dcc-stat-input" style="display: inline-block; width: 38px; text-align: center; background: #fef0db; font-weight: bold; color: #c0392b;" title="Rank {{skill.effectiveRank}} (Granted by: {{skill.itemSources}})">
                  {{skill.effectiveRank}}
                </span>
              {{else}}
                {{#if skill.itemBonus}}
                  <div style="display: flex; align-items: center; gap: 2px;" title="Base Rank: {{skill.system.rank}}, Total Effective Rank: {{skill.effectiveRank}} (+{{skill.itemBonus}} gear)">
                    <input class="dcc-stat-input item-inline-edit" type="number" data-field="system.rank" value="{{skill.system.rank}}" style="width: 28px;" />
                    <span style="font-size: 10px; color: #c0392b; font-weight: bold;" title="Active bonus from: {{skill.itemSources}}">+{{skill.itemBonus}}</span>
                  </div>
                {{else}}
                  <input class="dcc-stat-input item-inline-edit" type="number" data-field="system.rank" value="{{skill.system.rank}}" style="width: 38px;" title="Rank 0 = Untrained (Disadvantage)" />
                {{/if}}
              {{/if}}
            </td>
            <td>
              <div style="display: flex; align-items: center; gap: 4px;">
                {{#if skill.isGranted}}
                  <span style="font-family: 'Oswald', sans-serif; font-size: 11px; font-weight: bold;">{{upper skill.system.stat}}</span>
                {{else}}
                  <select class="item-inline-edit" data-field="system.stat" style="font-family: 'Oswald', sans-serif; font-size: 11px;">
                    <option value="str" {{#if (eq skill.system.stat "str")}}selected{{/if}}>STR</option>
                    <option value="int" {{#if (eq skill.system.stat "int")}}selected{{/if}}>INT</option>
                    <option value="con" {{#if (eq skill.system.stat "con")}}selected{{/if}}>CON</option>
                    <option value="dex" {{#if (eq skill.system.stat "dex")}}selected{{/if}}>DEX</option>
                    <option value="cha" {{#if (eq skill.system.stat "cha")}}selected{{/if}}>CHA</option>
                  </select>
                {{/if}}
                <span style="font-size: 11px; font-weight: bold; color: #c0392b;">{{skill.statModStr}}</span>
              </div>
            </td>
            <td>
              {{#if skill.isGranted}}
                <span style="font-size: 11px;">{{skill.system.checkType}}</span>
              {{else}}
                <input class="dcc-field-input item-inline-edit" type="text" data-field="system.checkType" value="{{skill.system.checkType}}" placeholder="Stat Check" />
              {{/if}}
            </td>
            <td>
              {{#if skill.isGranted}}
                <span style="font-size: 11px; font-style: italic; color: #555;">{{skill.system.notes}}</span>
              {{else}}
                <input class="dcc-field-input item-inline-edit" type="text" data-field="system.notes" value="{{skill.system.notes}}" placeholder="Notes..." />
              {{/if}}
            </td>
            <td>
              <button type="button" class="dcc-attack-roll-btn roll-skill" data-tooltip="Roll Skill Check (Rank {{skill.effectiveRank}})">
                <i class="fa-solid fa-dice-d20"></i> Roll
              </button>
              {{#unless skill.isGranted}}
                <a class="item-edit" data-tooltip="Edit Skill" style="margin-left: 4px;"><i class="fa-solid fa-edit"></i></a>
                <a class="item-delete" data-tooltip="Delete Skill" style="margin-left: 4px;"><i class="fa-solid fa-trash"></i></a>
              {{/unless}}
            </td>
          </tr>
        {{else}}
          <tr>
            <td colspan="6" style="text-align: center; color: #777; padding: 18px;">
              No skills added yet. Click <strong style="color: #f1c40f;">Select Skill</strong> above to pick from the official DCC Skill Library, or drag & drop from the Compendium.
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
