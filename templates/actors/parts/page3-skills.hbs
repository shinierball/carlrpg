{{!-- PAGE 3: SKILLS --}}
<div class="dcc-page-container">
  <div class="dcc-stat-block">
    <div class="dcc-banner-header">
      <span>SKILLS</span>
      <div style="display: flex; gap: 12px; align-items: center;">
        <a class="open-skill-picker" data-tooltip="Choose from official DCC Skill Library" style="color: #f1c40f; cursor: pointer; font-size: 13px; font-weight: normal; text-transform: none;">
          <i class="fa-solid fa-book-bookmark"></i> Select Skill
        </a>
        <a class="item-create" data-type="skill" data-tooltip="Create a custom skill" style="color: #fff; cursor: pointer; font-size: 13px; font-weight: normal; text-transform: none;">
          <i class="fa-solid fa-plus"></i> Custom Skill
        </a>
      </div>
    </div>

    <table class="dcc-attacks-table dcc-skills-table">
      <thead>
        <tr>
          <th style="width: 22%;">Skill Name</th>
          <th style="width: 7%; text-align: center;" title="Base Trained Rank">Base</th>
          <th style="width: 14%; text-align: center;" title="Bonuses from equipped gear, generic weapon groups, and boons">Item / Group / Boon</th>
          <th style="width: 8%; text-align: center;" title="Calculated rank after boons, items, and weapon group bonuses">Mod Rank</th>
          <th style="width: 11%;">Stat & Mod</th>
          <th style="width: 9%; text-align: center;" title="Total Skill Check Bonus (Modified Rank + Stat Mod)">Total</th>
          <th style="width: 11%;">Check Type</th>
          <th style="width: 10%;">Notes & Upgrades</th>
          <th style="width: 8%; text-align: center;">Roll</th>
        </tr>
      </thead>
      <tbody>
        {{#each skills as |skill|}}
          <tr data-item-id="{{skill.id}}" style="{{#if skill.isGranted}}background: #fdf5e6;{{/if}}">
            <td>
              <div style="display: flex; align-items: center; gap: 6px;">
                <img src="{{skill.img}}" style="width: 20px; height: 20px; border: 1px solid #333; border-radius: 3px; object-fit: contain; background: #222;" />
                {{#if skill.isGranted}}
                  <span style="font-weight: bold; flex: 1;" title="Granted by equipped gear: {{skill.itemSources}}">{{skill.name}}</span>
                  <span class="dcc-badge" style="background: #e67e22; color: #fff; font-size: 9px; padding: 1px 4px; border-radius: 2px;" title="Granted by equipped gear: {{skill.itemSources}}">GEAR</span>
                {{else}}
                  <input class="dcc-field-input item-inline-edit" type="text" data-field="name" value="{{skill.name}}" style="font-weight: bold; flex: 1;" />
                {{/if}}
                {{#if (or skill.system.skillType skill.system.type)}}
                  <span class="dcc-badge" style="background: #34495e; color: #ecf0f1; font-size: 8px; padding: 1px 3px; border-radius: 2px;" title="Skill Type: {{or skill.system.skillType skill.system.type}}">
                    {{upper (or skill.system.skillType skill.system.type)}}
                  </span>
                {{/if}}
              </div>
            </td>
            <td style="text-align: center;">
              {{#if skill.isGranted}}
                <span style="font-size: 11px; color: #888;" title="Base Rank 0 (Granted by gear)">0</span>
              {{else}}
                <input class="dcc-stat-input item-inline-edit" type="number" data-field="system.rank" value="{{skill.baseRank}}" style="width: 32px; text-align: center;" title="Base Trained Rank (Rank 0 = Untrained)" />
              {{/if}}
            </td>
            <td style="text-align: center;">
              <div style="display: inline-flex; align-items: center; gap: 3px; justify-content: center; flex-wrap: wrap;">
                {{#if skill.itemBonus}}
                  <span class="dcc-badge" style="background: #27ae60; color: #fff; font-size: 9px; padding: 2px 4px; border-radius: 2px; font-weight: bold;" title="Equipped Gear: +{{skill.itemBonus}} ({{skill.itemSources}})">
                    <i class="fa-solid fa-shield-halved"></i> +{{skill.itemBonus}}
                  </span>
                {{/if}}
                {{#if skill.typeBonus}}
                  <span class="dcc-badge" style="background: #2980b9; color: #fff; font-size: 9px; padding: 2px 4px; border-radius: 2px; font-weight: bold;" title="Weapon Group / Type: +{{skill.typeBonus}} ({{skill.typeSources}})">
                    <i class="fa-solid fa-layer-group"></i> +{{skill.typeBonus}}
                  </span>
                {{/if}}
                {{#if skill.boonBonus}}
                  <span class="dcc-badge" style="background: #8e44ad; color: #fff; font-size: 9px; padding: 2px 4px; border-radius: 2px; font-weight: bold;" title="Boon / Deity Bonus: +{{skill.boonBonus}}">
                    <i class="fa-solid fa-sparkles"></i> +{{skill.boonBonus}}
                  </span>
                {{/if}}
                {{#unless (or skill.itemBonus skill.typeBonus skill.boonBonus)}}
                  <span style="color: #bbb; font-size: 11px;">—</span>
                {{/unless}}
              </div>
            </td>
            <td style="text-align: center;">
              <span class="dcc-stat-input" style="display: inline-block; width: 34px; text-align: center; font-weight: 800; font-size: 12px; background: #fff8e7; color: #c0392b; border: 1.5px solid #d32f2f; border-radius: 3px; line-height: 18px;" title="Modified Rank: {{skill.modifiedRank}} (Base {{skill.baseRank}} + Items {{skill.itemBonus}} + Group {{skill.typeBonus}} + Boons {{skill.boonBonus}})">
                {{skill.modifiedRank}}
              </span>
            </td>
            <td>
              <div style="display: flex; align-items: center; gap: 4px;">
                {{#if skill.isGranted}}
                  <span style="font-family: 'Oswald', sans-serif; font-size: 11px; font-weight: bold;">{{upper skill.system.stat}}</span>
                {{else}}
                  <select class="item-inline-edit" data-field="system.stat" style="font-family: 'Oswald', sans-serif; font-size: 11px;">
                    <option value="str" {{#if (eq skill.system.stat "str")}}selected{{/if}}>STR</option>
                    <option value="int" {{#if (eq skill.system.stat "int")}}selected{{/if}}>INT</option>
                    <option value="con" {{#if (eq skill.system.stat "con")}}selected{{/if}}>CON</option>
                    <option value="dex" {{#if (eq skill.system.stat "dex")}}selected{{/if}}>DEX</option>
                    <option value="cha" {{#if (eq skill.system.stat "cha")}}selected{{/if}}>CHA</option>
                  </select>
                {{/if}}
                <span style="font-size: 11px; font-weight: bold; color: #c0392b;" title="{{upper skill.system.stat}} Stat Mod: {{skill.statModStr}}">{{skill.statModStr}}</span>
              </div>
            </td>
            <td style="text-align: center;">
              <span style="font-family: 'Oswald', sans-serif; font-size: 12px; font-weight: 800; color: #111; display: inline-block; background: #f0f0f0; padding: 1px 5px; border-radius: 3px; border: 1px solid #ccc; text-align: center; min-width: 28px;" title="Total Skill: Modified Rank ({{skill.modifiedRank}}) + Stat Mod ({{skill.statModStr}}) = {{skill.totalSkillStr}}">
                {{skill.totalSkillStr}}
              </span>
            </td>
            <td>
              {{#if skill.isGranted}}
                <span style="font-size: 11px;">{{skill.system.checkType}}</span>
              {{else}}
                <input class="dcc-field-input item-inline-edit" type="text" data-field="system.checkType" value="{{skill.system.checkType}}" placeholder="Stat Check" />
              {{/if}}
            </td>
            <td>
              {{#if skill.isGranted}}
                <span style="font-size: 11px; font-style: italic; color: #555;">{{skill.system.notes}}</span>
              {{else}}
                <input class="dcc-field-input item-inline-edit" type="text" data-field="system.notes" value="{{skill.system.notes}}" placeholder="Notes..." />
              {{/if}}
            </td>
            <td style="text-align: center; white-space: nowrap;">
              {{#if skill.isAttack}}
                <button type="button" class="dcc-attack-roll-btn roll-skill" data-tooltip="Roll Attack (To Hit): 1d20 + Rank {{skill.modifiedRank}} + {{skill.statModStr}} vs Target Evade" style="font-size: 10px; padding: 2px 6px;">
                  <i class="fa-solid fa-dice-d20"></i>
                </button>
              {{else}}
                <button type="button" class="dcc-attack-roll-btn roll-skill" data-tooltip="Roll Skill Check: 1d20 + Total ({{skill.totalSkillStr}}) | Modified Rank: {{skill.modifiedRank}}" style="font-size: 10px; padding: 2px 6px;">
                  <i class="fa-solid fa-dice-d20"></i>
                </button>
              {{/if}}
              {{#if skill.hasDamage}}
                <button type="button" class="dcc-attack-roll-btn roll-skill-dmg" data-tooltip="Roll Attack Damage: {{skill.damageFormulaWithStat}}" style="font-size: 10px; padding: 2px 6px; background: #c0392b; color: #fff; margin-left: 2px;">
                  <i class="fa-solid fa-burst"></i>
                </button>
              {{/if}}
              {{#unless skill.isGranted}}
                <a class="item-edit" data-tooltip="Edit Skill" style="margin-left: 3px; font-size: 11px;"><i class="fa-solid fa-edit"></i></a>
                <a class="item-delete" data-tooltip="Delete Skill" style="margin-left: 3px; font-size: 11px;"><i class="fa-solid fa-trash"></i></a>
              {{/unless}}
            </td>
          </tr>
        {{else}}
          <tr>
            <td colspan="9" style="text-align: center; color: #777; padding: 18px;">
              No skills added yet. Click <strong style="color: #f1c40f;">Select Skill</strong> above to pick from the official DCC Skill Library, or drag & drop from the Compendium.
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
