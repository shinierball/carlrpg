{{!-- PAGE 4: INVENTORY --}}
<div class="dcc-page-container">
  <div class="dcc-stat-block">
    <div class="dcc-banner-header">
      <span>INVENTORY</span>
      <div>
        <a class="item-create" data-type="gear" data-tooltip="Add Gear" style="color: #fff; cursor: pointer; margin-right: 12px;"><i class="fa-solid fa-shield"></i> Add Gear</a>
        <a class="item-create" data-type="loot" data-tooltip="Add Item" style="color: #fff; cursor: pointer; margin-right: 12px;"><i class="fa-solid fa-plus"></i> Add Item</a>
        <a class="item-create" data-type="buff" data-tooltip="Add Buff" style="color: #fff; cursor: pointer;"><i class="fa-solid fa-sparkles"></i> Add Buff</a>
      </div>
    </div>

    <table class="dcc-attacks-table">
      <thead>
        <tr>
          <th style="width: 35%;">Item</th>
          <th style="width: 10%;">Quantity</th>
          <th style="width: 45%;">Notes / Slot</th>
          <th style="width: 10%;">Actions</th>
        </tr>
      </thead>
      <tbody>
        {{!-- Gear Items --}}
        {{#each gear as |item|}}
          <tr data-item-id="{{item.id}}" style="{{#if item.system.equipped}}background: #fdf2f2;{{/if}}">
            <td>
              <div style="display: flex; align-items: center; gap: 6px;">
                <button type="button" class="gear-toggle-equipped" data-tooltip="{{#if item.system.equipped}}Equipped to {{upper item.system.slot}} (Click to unequip){{else}}Unequipped (Click to equip to {{upper item.system.slot}}){{/if}}" style="background: none; border: none; cursor: pointer; padding: 2px 4px; font-size: 14px;">
                  {{#if item.system.equipped}}
                    <i class="fa-solid fa-shield-halved" style="color: #c0392b;"></i>
                  {{else}}
                    <i class="fa-regular fa-circle" style="color: #999;"></i>
                  {{/if}}
                </button>
                <div>
                  <span style="font-weight: bold;">{{item.name}}</span>
                  <span class="dcc-stat-sublabel" style="display: inline-block; margin-left: 4px; text-transform: uppercase;">[{{item.system.slot}}]</span>
                  {{#if item.system.equipped}}
                    <span class="dcc-badge" style="background: #c0392b; color: #fff; font-size: 9px; padding: 1px 4px; border-radius: 2px; margin-left: 4px;">EQUIPPED</span>
                  {{/if}}
                  {{#if item.bonusesSummary}}
                    <div style="font-size: 10px; color: #555; margin-top: 2px;">
                      <i class="fa-solid fa-sparkles" style="color: #c0392b;"></i> {{item.bonusesSummary}}
                    </div>
                  {{/if}}
                </div>
              </div>
            </td>
            <td>
              <input class="dcc-stat-input item-inline-edit" type="number" data-field="system.quantity" value="{{item.system.quantity}}" style="width: 44px;" />
            </td>
            <td>
              <input class="dcc-field-input item-inline-edit" type="text" data-field="system.notes" value="{{item.system.notes}}" placeholder="Notes..." />
            </td>
            <td>
              <a class="item-edit" data-tooltip="Edit"><i class="fa-solid fa-edit"></i></a>
              <a class="item-delete" data-tooltip="Delete" style="margin-left: 6px;"><i class="fa-solid fa-trash"></i></a>
            </td>
          </tr>
        {{/each}}

        {{!-- Loot / Other Items --}}
        {{#each loot as |item|}}
          <tr data-item-id="{{item.id}}">
            <td>
              <span style="font-weight: bold;">{{item.name}}</span>
            </td>
            <td>
              <input class="dcc-stat-input item-inline-edit" type="number" data-field="system.quantity" value="{{item.system.quantity}}" style="width: 44px;" />
            </td>
            <td>
              <input class="dcc-field-input item-inline-edit" type="text" data-field="system.notes" value="{{item.system.notes}}" placeholder="Notes..." />
            </td>
            <td>
              <a class="item-edit" data-tooltip="Edit"><i class="fa-solid fa-edit"></i></a>
              <a class="item-delete" data-tooltip="Delete" style="margin-left: 6px;"><i class="fa-solid fa-trash"></i></a>
            </td>
          </tr>
        {{/each}}

        {{#unless gear.length}}
          {{#unless loot.length}}
            <tr>
              <td colspan="4" style="text-align: center; color: #777; padding: 14px;">
                Inventory is empty. Drag and drop items or click <strong>Add Item</strong>.
              </td>
            </tr>
          {{/unless}}
        {{/unless}}
      </tbody>
    </table>
  </div>

  {{!-- BUFFS TABLE (IF OWNED) --}}
  {{#if buffs.length}}
    <div class="dcc-stat-block" style="margin-top: 14px;">
      <div class="dcc-banner-header" style="display: flex; justify-content: space-between; align-items: center;">
        <span>CHARACTER BUFFS & ACTIVE EFFECTS</span>
        <div style="display: flex; gap: 8px; align-items: center;">
          <a class="open-buff-picker" data-tooltip="Browse Buffs Compendium" style="color: #f1c40f; cursor: pointer; font-size: 11px; font-weight: normal; text-transform: none;">
            <i class="fa-solid fa-sparkles"></i> Browse Buffs
          </a>
          <a class="item-create" data-type="buff" data-tooltip="Add Buff" style="color: #fff; cursor: pointer; font-size: 11px; font-weight: normal; text-transform: none;">
            <i class="fa-solid fa-plus"></i> Add Buff
          </a>
        </div>
      </div>
      <table class="dcc-attacks-table">
        <thead>
          <tr>
            <th style="width: 35%;">Buff Name</th>
            <th style="width: 25%;">Type</th>
            <th style="width: 30%;">Duration / Notes</th>
            <th style="width: 10%;">Actions</th>
          </tr>
        </thead>
        <tbody>
          {{#each buffs as |item|}}
            <tr data-item-id="{{item.id}}">
              <td>
                <div style="display: flex; align-items: center; gap: 6px;">
                  <img src="{{item.img}}" style="width: 20px; height: 20px; border-radius: 2px; border: 1px solid #333;" />
                  <span style="font-weight: bold;">{{item.name}}</span>
                </div>
              </td>
              <td>
                <span class="dcc-stat-sublabel" style="text-transform: uppercase;">{{item.system.buffType}}</span>
              </td>
              <td>
                <span>{{item.system.duration}}</span>
              </td>
              <td>
                <a class="item-edit" data-tooltip="Edit"><i class="fa-solid fa-edit"></i></a>
                <a class="item-delete" data-tooltip="Delete" style="margin-left: 6px;"><i class="fa-solid fa-trash"></i></a>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  {{/if}}

  {{!-- DEBUFFS & CONDITIONS TABLE --}}
  <div class="dcc-stat-block" style="margin-top: 14px;">
    <div class="dcc-banner-header" style="background: #962d22; display: flex; justify-content: space-between; align-items: center;">
      <span>CHARACTER DEBUFFS & CONDITIONS</span>
      <div style="display: flex; gap: 8px; align-items: center;">
        <a class="open-debuff-picker" data-tooltip="Browse Conditions Compendium" style="color: #f1c40f; cursor: pointer; font-size: 11px; font-weight: normal; text-transform: none;">
          <i class="fa-solid fa-book-skull"></i> Browse
        </a>
        <a class="item-create" data-type="debuff" data-tooltip="Add Custom Debuff" style="color: #fff; cursor: pointer; font-size: 11px; font-weight: normal; text-transform: none;">
          <i class="fa-solid fa-plus"></i> Add Debuff
        </a>
      </div>
    </div>
    <table class="dcc-attacks-table">
      <thead>
        <tr>
          <th style="width: 30%;">Debuff / Condition</th>
          <th style="width: 15%;">Severity</th>
          <th style="width: 25%;">Effects & Penalties</th>
          <th style="width: 20%;">Duration</th>
          <th style="width: 10%; text-align: center;">Actions</th>
        </tr>
      </thead>
      <tbody>
        {{#each debuffs as |item|}}
          <tr data-item-id="{{item.id}}">
            <td>
              <div style="display: flex; align-items: center; gap: 6px;">
                <img src="{{item.img}}" style="width: 20px; height: 20px; border-radius: 2px; border: 1px solid #333;" />
                <span style="font-weight: bold;">{{item.name}}</span>
              </div>
            </td>
            <td>
              <span class="dcc-badge {{#if (eq item.system.severity 'Major')}}dcc-badge-attack{{else}}dcc-badge-item{{/if}}" style="font-size: 9px; padding: 2px 5px;">
                {{upper item.system.severity}}
              </span>
            </td>
            <td>
              <span style="font-size: 11px; color: #c0392b; font-weight: bold;">{{item.summary}}</span>
            </td>
            <td>
              <span style="font-size: 11px;">{{item.system.duration}}</span>
            </td>
            <td style="text-align: center;">
              <a class="item-edit" data-tooltip="Edit"><i class="fa-solid fa-edit"></i></a>
              <a class="item-delete" data-tooltip="Delete" style="margin-left: 6px; color: #c0392b;"><i class="fa-solid fa-trash"></i></a>
            </td>
          </tr>
        {{else}}
          <tr>
            <td colspan="5" style="text-align: center; color: #777; padding: 10px; font-style: italic;">
              No active debuffs or conditions.
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
