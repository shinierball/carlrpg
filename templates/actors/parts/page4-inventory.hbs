{{!-- PAGE 4: EQUIPMENT & INVENTORY --}}
<div class="dcc-page-container dcc-equipment-inventory-container">
  
  {{#if system.attributes.limbs.exceededHands}}
    <div class="dcc-hands-warning-banner" role="alert" style="margin-bottom: 8px;">
      <i class="fa-solid fa-triangle-exclamation"></i>
      <span><strong>WARNING — HANDS LIMIT EXCEEDED:</strong> Wielding gear in <strong>{{system.attributes.limbs.usedHands}}</strong> hands, but only <strong>{{system.attributes.limbs.maxHands}}</strong> hands available!</span>
    </div>
  {{/if}}

  {{!-- TOP GROUPING: EQUIPPED GEAR SLOTS / TATTOOS / PATCHES (FULL WIDTH) --}}
  <div class="dcc-stat-block dcc-equipped-gear-block" style="width: 100%; box-sizing: border-box;">
    <div class="dcc-banner-header">
      <span><i class="fa-solid fa-shield-halved"></i> EQUIPPED GEAR SLOTS</span>
      <div style="display: flex; gap: 12px; align-items: center;">
        <a class="open-gear-picker" data-tooltip="Choose from existing DCC Gear &amp; Equipment" style="color: #f1c40f; cursor: pointer; font-size: 13px; font-weight: normal; text-transform: none;">
          <i class="fa-solid fa-shirt"></i> Select Gear
        </a>
        <a class="item-create" data-type="gear" data-tooltip="Create custom gear" style="color: #fff; cursor: pointer; font-size: 13px; font-weight: normal; text-transform: none;">
          <i class="fa-solid fa-plus"></i> Custom Gear
        </a>
      </div>
    </div>
    <div class="dcc-limbs-bar" style="display: flex; align-items: center; justify-content: space-between; background: rgba(0, 0, 0, 0.4); border-bottom: 1px solid #444; padding: 6px 12px; margin-bottom: 4px;">
      <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
        <div style="display: flex; align-items: center; gap: 6px;">
          <span style="font-weight: bold; font-size: 11px; color: #fff;"><i class="fa-solid fa-hand"></i> Hands:</span>
          {{#if isGM}}
            <input type="number" name="system.attributes.limbs.hands" value="{{system.attributes.limbs.hands}}" min="0" style="width: 44px; text-align: center; height: 20px; font-size: 11px; background: #111; color: #fff; border: 1px solid #777; border-radius: 3px;" title="GM Editable Base Hands" />
          {{else}}
            <span style="font-weight: bold; color: #fff; font-size: 11px;">{{system.attributes.limbs.hands}}</span>
          {{/if}}
          <span style="font-size: 11px; color: {{#if system.attributes.limbs.exceededHands}}#e74c3c{{else}}#ccc{{/if}};">(Wielding: <strong>{{system.attributes.limbs.usedHands}}</strong> / Max: <strong>{{system.attributes.limbs.maxHands}}</strong>)</span>
        </div>

        <div style="display: flex; align-items: center; gap: 6px;">
          <span style="font-weight: bold; font-size: 11px; color: #fff;"><i class="fa-solid fa-person-walking"></i> Arms:</span>
          {{#if isGM}}
            <input type="number" name="system.attributes.limbs.arms" value="{{system.attributes.limbs.arms}}" min="0" style="width: 44px; text-align: center; height: 20px; font-size: 11px; background: #111; color: #fff; border: 1px solid #777; border-radius: 3px;" title="GM Editable Base Arms" />
          {{else}}
            <span style="font-weight: bold; color: #fff; font-size: 11px;">{{system.attributes.limbs.arms}}</span>
          {{/if}}
          <span style="font-size: 11px; color: #ccc;">(Max: <strong>{{system.attributes.limbs.maxArms}}</strong>)</span>
        </div>

        <div style="display: flex; align-items: center; gap: 6px;">
          <span style="font-weight: bold; font-size: 11px; color: #fff;"><i class="fa-solid fa-shoe-prints"></i> Legs:</span>
          {{#if isGM}}
            <input type="number" name="system.attributes.limbs.legs" value="{{system.attributes.limbs.legs}}" min="0" style="width: 44px; text-align: center; height: 20px; font-size: 11px; background: #111; color: #fff; border: 1px solid #777; border-radius: 3px;" title="GM Editable Base Legs" />
          {{else}}
            <span style="font-weight: bold; color: #fff; font-size: 11px;">{{system.attributes.limbs.legs}}</span>
          {{/if}}
          <span style="font-size: 11px; color: #ccc;">(Max: <strong>{{system.attributes.limbs.maxLegs}}</strong>)</span>
        </div>
      </div>
      {{#if isGM}}
        <span style="font-size: 10px; color: #f1c40f; font-style: italic;"><i class="fa-solid fa-crown"></i> GM Limb Config</span>
      {{/if}}
    </div>
    <div class="dcc-gear-slots-list dcc-gear-slots-grid" style="padding: 8px;">
      <div class="dcc-gear-row">
        <span class="dcc-gear-label">Head</span>
        <div style="display: flex; gap: 4px; flex: 1; align-items: center;">
          {{#if equippedBySlot.head}}
            <span class="dcc-badge" style="background: #c0392b; color: #fff; padding: 2px 6px; font-size: 10px; border-radius: 3px; white-space: nowrap;" title="{{equippedBySlot.head.bonusesSummary}}">
              <i class="fa-solid fa-shield-halved"></i> {{equippedBySlot.head.name}}
            </span>
          {{/if}}
          <input class="dcc-field-input" type="text" name="system.gearSlots.head" value="{{system.gearSlots.head}}" placeholder="{{#if equippedBySlot.head}}{{equippedBySlot.head.name}}{{else}}Notes...{{/if}}" />
        </div>
      </div>
      <div class="dcc-gear-row">
        <span class="dcc-gear-label">Torso</span>
        <div style="display: flex; gap: 4px; flex: 1; align-items: center;">
          {{#if equippedBySlot.torso}}
            <span class="dcc-badge" style="background: #c0392b; color: #fff; padding: 2px 6px; font-size: 10px; border-radius: 3px; white-space: nowrap;" title="{{equippedBySlot.torso.bonusesSummary}}">
              <i class="fa-solid fa-shield-halved"></i> {{equippedBySlot.torso.name}}
            </span>
          {{/if}}
          <input class="dcc-field-input" type="text" name="system.gearSlots.torso" value="{{system.gearSlots.torso}}" placeholder="{{#if equippedBySlot.torso}}{{equippedBySlot.torso.name}}{{else}}Notes...{{/if}}" />
        </div>
      </div>
      <div class="dcc-gear-row">
        <span class="dcc-gear-label">Arms</span>
        <div style="display: flex; gap: 4px; flex: 1; align-items: center;">
          {{#if equippedBySlot.arms}}
            <span class="dcc-badge" style="background: #c0392b; color: #fff; padding: 2px 6px; font-size: 10px; border-radius: 3px; white-space: nowrap;" title="{{equippedBySlot.arms.bonusesSummary}}">
              <i class="fa-solid fa-shield-halved"></i> {{equippedBySlot.arms.name}}
            </span>
          {{/if}}
          <input class="dcc-field-input" type="text" name="system.gearSlots.arms" value="{{system.gearSlots.arms}}" placeholder="{{#if equippedBySlot.arms}}{{equippedBySlot.arms.name}}{{else}}Notes...{{/if}}" />
        </div>
      </div>
      <div class="dcc-gear-row">
        <span class="dcc-gear-label">Hands/Holding</span>
        <div style="display: flex; gap: 4px; flex: 1; align-items: center;">
          {{#if equippedBySlot.hands}}
            <span class="dcc-badge" style="background: #c0392b; color: #fff; padding: 2px 6px; font-size: 10px; border-radius: 3px; white-space: nowrap;" title="{{equippedBySlot.hands.bonusesSummary}}">
              <i class="fa-solid fa-shield-halved"></i> {{equippedBySlot.hands.name}}
            </span>
          {{/if}}
          <input class="dcc-field-input" type="text" name="system.gearSlots.hands" value="{{system.gearSlots.hands}}" placeholder="{{#if equippedBySlot.hands}}{{equippedBySlot.hands.name}}{{else}}Notes...{{/if}}" />
        </div>
      </div>
      <div class="dcc-gear-row">
        <span class="dcc-gear-label">Legs</span>
        <div style="display: flex; gap: 4px; flex: 1; align-items: center;">
          {{#if equippedBySlot.legs}}
            <span class="dcc-badge" style="background: #c0392b; color: #fff; padding: 2px 6px; font-size: 10px; border-radius: 3px; white-space: nowrap;" title="{{equippedBySlot.legs.bonusesSummary}}">
              <i class="fa-solid fa-shield-halved"></i> {{equippedBySlot.legs.name}}
            </span>
          {{/if}}
          <input class="dcc-field-input" type="text" name="system.gearSlots.legs" value="{{system.gearSlots.legs}}" placeholder="{{#if equippedBySlot.legs}}{{equippedBySlot.legs.name}}{{else}}Notes...{{/if}}" />
        </div>
      </div>
      <div class="dcc-gear-row">
        <span class="dcc-gear-label">Feet</span>
        <div style="display: flex; gap: 4px; flex: 1; align-items: center;">
          {{#if equippedBySlot.feet}}
            <span class="dcc-badge" style="background: #c0392b; color: #fff; padding: 2px 6px; font-size: 10px; border-radius: 3px; white-space: nowrap;" title="{{equippedBySlot.feet.bonusesSummary}}">
              <i class="fa-solid fa-shield-halved"></i> {{equippedBySlot.feet.name}}
            </span>
          {{/if}}
          <input class="dcc-field-input" type="text" name="system.gearSlots.feet" value="{{system.gearSlots.feet}}" placeholder="{{#if equippedBySlot.feet}}{{equippedBySlot.feet.name}}{{else}}Notes...{{/if}}" />
        </div>
      </div>
      <div class="dcc-gear-row dcc-gear-row-full" style="grid-column: 1 / -1;">
        <span class="dcc-gear-label">Accessories (Max 10)</span>
        <div style="display: flex; flex-direction: column; gap: 4px; flex: 1;">
          {{#if equippedBySlot.accessory.length}}
            <div style="display: flex; flex-wrap: wrap; gap: 4px;">
              {{#each equippedBySlot.accessory as |acc|}}
                <span class="dcc-badge" style="background: #c0392b; color: #fff; padding: 1px 5px; font-size: 9px; border-radius: 2px;" title="{{acc.bonusesSummary}}">
                  {{acc.name}}
                </span>
              {{/each}}
            </div>
          {{/if}}
          <textarea class="dcc-field-input" name="system.gearSlots.accessories" style="height: 80px; resize: vertical;">{{system.gearSlots.accessories}}</textarea>
        </div>
      </div>
    </div>
  </div>

  {{!-- BOTTOM GROUPING: INVENTORY & BACKPACK ITEMS (FULL WIDTH, BELOW GEAR SLOTS) --}}
  <div class="dcc-stat-block dcc-inventory-backpack-block" style="width: 100%; box-sizing: border-box;">
    <div class="dcc-banner-header">
      <span><i class="fa-solid fa-boxes-stacked"></i> INVENTORY &amp; BACKPACK</span>
      <div style="display: flex; align-items: center; gap: 8px;">
        <label style="font-size: 11px; display: inline-flex; align-items: center; gap: 4px; color: #fff; margin: 0; cursor: pointer;">
          <i class="fa-solid fa-arrow-down-short-wide"></i> Sort:
          <select class="inventory-sort-select" style="background: rgba(0,0,0,0.5); color: #fff; border: 1px solid #777; border-radius: 3px; font-size: 11px; padding: 1px 4px; cursor: pointer;">
            <option value="default" {{#if (eq inventorySort "default")}}selected{{/if}}>Manual / Default</option>
            <option value="name" {{#if (eq inventorySort "name")}}selected{{/if}}>Name (A-Z)</option>
            {{#if canSortByValue}}
              <option value="value-desc" {{#if (eq inventorySort "value-desc")}}selected{{/if}}>Value (High to Low)</option>
              <option value="value-asc" {{#if (eq inventorySort "value-asc")}}selected{{/if}}>Value (Low to High)</option>
            {{else}}
              <option value="" disabled title="Requires Determine Value Rank 5">🔒 Value (Req. Rank 5)</option>
            {{/if}}
          </select>
        </label>
        <a class="open-item-picker" data-tooltip="Choose from existing DCC Items &amp; Gear" style="color: #f1c40f; cursor: pointer; margin-left: 6px; font-size: 12px; font-weight: normal; text-transform: none;">
          <i class="fa-solid fa-box-open"></i> Select Item/Gear
        </a>
        <a class="item-create" data-type="gear" data-tooltip="Create custom gear" style="color: #fff; cursor: pointer; margin-left: 4px; font-size: 12px; font-weight: normal; text-transform: none;">
          <i class="fa-solid fa-shield"></i> Custom Gear
        </a>
        <a class="item-create" data-type="loot" data-tooltip="Create custom item" style="color: #fff; cursor: pointer; margin-left: 4px; font-size: 12px; font-weight: normal; text-transform: none;">
          <i class="fa-solid fa-plus"></i> Custom Item
        </a>
      </div>
    </div>

    <table class="dcc-attacks-table" style="width: 100%;">
      <thead>
        <tr>
          <th style="width: 36%;">Item</th>
          <th style="width: 10%;">Qty</th>
          <th style="width: 14%; text-align: center;"><i class="fa-solid fa-coins" style="color: #9a6306;"></i> Value</th>
          <th style="width: 28%;">Notes / Slot</th>
          <th style="width: 12%; text-align: center;">Actions</th>
        </tr>
      </thead>
      <tbody>
        {{!-- Gear Items --}}
        {{#each gear as |item|}}
          <tr data-item-id="{{item.id}}" draggable="true" style="{{#if item.system.equipped}}background: #fdf2f2;{{/if}}">
            <td>
              <div style="display: flex; align-items: center; gap: 6px;">
                <button type="button" class="gear-toggle-equipped" data-tooltip="{{#if item.system.equipped}}Equipped to {{upper item.system.slot}} (Click to unequip){{else}}Unequipped (Click to equip to {{upper item.system.slot}}){{/if}}" style="background: none; border: none; cursor: pointer; padding: 2px 4px; font-size: 14px;">
                  {{#if item.system.equipped}}
                    <i class="fa-solid fa-shield-halved" style="color: #c0392b;"></i>
                  {{else}}
                    <i class="fa-regular fa-circle" style="color: #444444;"></i>
                  {{/if}}
                </button>
                <div>
                  <span style="font-weight: bold;">{{item.name}}</span>
                  <span class="dcc-stat-sublabel" style="display: inline-block; margin-left: 4px; text-transform: uppercase;">[{{item.system.slot}}]</span>
                  {{#if item.system.equipped}}
                    <span class="dcc-badge" style="background: #c0392b; color: #fff; font-size: 9px; padding: 1px 4px; border-radius: 2px; margin-left: 4px;">EQUIPPED</span>
                  {{/if}}
                  {{#if item.bonusesSummary}}
                    <div style="font-size: 10px; color: #222222; margin-top: 2px;">
                      <i class="fa-solid fa-sparkles" style="color: #c0392b;"></i> {{item.bonusesSummary}}
                    </div>
                  {{/if}}
                </div>
              </div>
            </td>
            <td>
              <input class="dcc-stat-input item-inline-edit" type="number" data-field="system.quantity" value="{{item.system.quantity}}" style="width: 44px;" />
            </td>
            <td style="text-align: center; white-space: nowrap;">
              {{#if ../canSeeItemValue}}
                <span class="dcc-gold-value" style="color: #7e5109; font-weight: bold; font-size: 11px;">
                  <i class="fa-solid fa-coins" style="color: #9a6306; font-size: 10px;"></i> {{item.goldValue}} GP
                </span>
              {{else}}
                <span class="dcc-gold-value-hidden" style="color: #333333; font-style: italic; font-size: 11px;" title="Requires Determine Value Rank 10 to identify gold value">
                  <i class="fa-solid fa-eye-slash" style="font-size: 10px;"></i> ???
                </span>
              {{/if}}
            </td>
            <td>
              <input class="dcc-field-input item-inline-edit" type="text" data-field="system.notes" value="{{item.system.notes}}" placeholder="Notes..." />
            </td>
            <td style="text-align: center;">
              {{#if (or item.system.hasActivatedAbility item.system.outcomes.length)}}
                <a class="item-use" data-tooltip="Activate Gear" style="color: #c0392b; cursor: pointer; margin-right: 6px;"><i class="fa-solid fa-bolt"></i></a>
              {{/if}}
              <a class="item-edit" data-tooltip="Edit"><i class="fa-solid fa-edit"></i></a>
              <a class="item-delete" data-tooltip="Delete" style="margin-left: 6px;"><i class="fa-solid fa-trash"></i></a>
            </td>
          </tr>
        {{/each}}

        {{!-- Loot / Other Items --}}
        {{#each loot as |item|}}
          <tr data-item-id="{{item.id}}" draggable="true">
            <td>
              <span style="font-weight: bold;">{{item.name}}</span>
            </td>
            <td>
              <input class="dcc-stat-input item-inline-edit" type="number" data-field="system.quantity" value="{{item.system.quantity}}" style="width: 44px;" />
            </td>
            <td style="text-align: center; white-space: nowrap;">
              {{#if ../canSeeItemValue}}
                <span class="dcc-gold-value" style="color: #7e5109; font-weight: bold; font-size: 11px;">
                  <i class="fa-solid fa-coins" style="color: #9a6306; font-size: 10px;"></i> {{item.goldValue}} GP
                </span>
              {{else}}
                <span class="dcc-gold-value-hidden" style="color: #333333; font-style: italic; font-size: 11px;" title="Requires Determine Value Rank 10 to identify gold value">
                  <i class="fa-solid fa-eye-slash" style="font-size: 10px;"></i> ???
                </span>
              {{/if}}
            </td>
            <td>
              <input class="dcc-field-input item-inline-edit" type="text" data-field="system.notes" value="{{item.system.notes}}" placeholder="Notes..." />
            </td>
            <td style="text-align: center;">
              <a class="item-use" data-tooltip="Use Item" style="color: #1a5276; cursor: pointer; margin-right: 6px;"><i class="fa-solid fa-flask"></i></a>
              <a class="item-edit" data-tooltip="Edit"><i class="fa-solid fa-edit"></i></a>
              <a class="item-delete" data-tooltip="Delete" style="margin-left: 6px;"><i class="fa-solid fa-trash"></i></a>
            </td>
          </tr>
        {{/each}}

        {{#unless gear.length}}
          {{#unless loot.length}}
            <tr>
              <td colspan="5" style="text-align: center; color: #333333; padding: 14px;">
                Inventory is empty. Drag and drop items or click <strong>Add Gear</strong> / <strong>Add Item</strong>.
              </td>
            </tr>
          {{/unless}}
        {{/unless}}
      </tbody>
    </table>
  </div>

</div>
