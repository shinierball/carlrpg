{{!-- PAGE 4: INVENTORY --}}
<div class="dcc-page-container">
  <div class="dcc-stat-block">
    <div class="dcc-banner-header">
      <span>INVENTORY</span>
      <div>
        <a class="item-create" data-type="gear" data-tooltip="Add Gear" style="color: #fff; cursor: pointer; margin-right: 12px;"><i class="fa-solid fa-shield"></i> Add Gear</a>
        <a class="item-create" data-type="loot" data-tooltip="Add Item" style="color: #fff; cursor: pointer;"><i class="fa-solid fa-plus"></i> Add Item</a>
      </div>
    </div>

    <table class="dcc-attacks-table">
      <thead>
        <tr>
          <th style="width: 35%;">Item</th>
          <th style="width: 10%;">Quantity</th>
          <th style="width: 45%;">Notes / Slot</th>
          <th style="width: 10%;">Actions</th>
        </tr>
      </thead>
      <tbody>
        {{!-- Gear Items --}}
        {{#each gear as |item|}}
          <tr data-item-id="{{item.id}}" style="{{#if item.system.equipped}}background: #fdf2f2;{{/if}}">
            <td>
              <div style="display: flex; align-items: center; gap: 6px;">
                <button type="button" class="gear-toggle-equipped" data-tooltip="{{#if item.system.equipped}}Equipped to {{upper item.system.slot}} (Click to unequip){{else}}Unequipped (Click to equip to {{upper item.system.slot}}){{/if}}" style="background: none; border: none; cursor: pointer; padding: 2px 4px; font-size: 14px;">
                  {{#if item.system.equipped}}
                    <i class="fa-solid fa-shield-halved" style="color: #c0392b;"></i>
                  {{else}}
                    <i class="fa-regular fa-circle" style="color: #999;"></i>
                  {{/if}}
                </button>
                <div>
                  <span style="font-weight: bold;">{{item.name}}</span>
                  <span class="dcc-stat-sublabel" style="display: inline-block; margin-left: 4px; text-transform: uppercase;">[{{item.system.slot}}]</span>
                  {{#if item.system.equipped}}
                    <span class="dcc-badge" style="background: #c0392b; color: #fff; font-size: 9px; padding: 1px 4px; border-radius: 2px; margin-left: 4px;">EQUIPPED</span>
                  {{/if}}
                  {{#if item.bonusesSummary}}
                    <div style="font-size: 10px; color: #555; margin-top: 2px;">
                      <i class="fa-solid fa-sparkles" style="color: #c0392b;"></i> {{item.bonusesSummary}}
                    </div>
                  {{/if}}
                </div>
              </div>
            </td>
            <td>
              <input class="dcc-stat-input item-inline-edit" type="number" data-field="system.quantity" value="{{item.system.quantity}}" style="width: 44px;" />
            </td>
            <td>
              <input class="dcc-field-input item-inline-edit" type="text" data-field="system.notes" value="{{item.system.notes}}" placeholder="Notes..." />
            </td>
            <td>
              <a class="item-edit" data-tooltip="Edit"><i class="fa-solid fa-edit"></i></a>
              <a class="item-delete" data-tooltip="Delete" style="margin-left: 6px;"><i class="fa-solid fa-trash"></i></a>
            </td>
          </tr>
        {{/each}}

        {{!-- Loot / Other Items --}}
        {{#each loot as |item|}}
          <tr data-item-id="{{item.id}}">
            <td>
              <span style="font-weight: bold;">{{item.name}}</span>
            </td>
            <td>
              <input class="dcc-stat-input item-inline-edit" type="number" data-field="system.quantity" value="{{item.system.quantity}}" style="width: 44px;" />
            </td>
            <td>
              <input class="dcc-field-input item-inline-edit" type="text" data-field="system.notes" value="{{item.system.notes}}" placeholder="Notes..." />
            </td>
            <td>
              <a class="item-edit" data-tooltip="Edit"><i class="fa-solid fa-edit"></i></a>
              <a class="item-delete" data-tooltip="Delete" style="margin-left: 6px;"><i class="fa-solid fa-trash"></i></a>
            </td>
          </tr>
        {{/each}}

        {{#unless gear.length}}
          {{#unless loot.length}}
            <tr>
              <td colspan="4" style="text-align: center; color: #777; padding: 14px;">
                Inventory is empty. Drag and drop items or click <strong>Add Item</strong>.
              </td>
            </tr>
          {{/unless}}
        {{/unless}}
      </tbody>
    </table>
  </div>
</div>
