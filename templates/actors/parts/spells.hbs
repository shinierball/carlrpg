{{!-- PAGE: SPELLS --}}
<div class="dcc-page-container">
  <div class="dcc-stat-block">
    <div class="dcc-banner-header">
      <span><i class="fa-solid fa-wand-magic-sparkles"></i> SPELLS</span>
      <div style="display: flex; gap: 12px; align-items: center;">
        <a class="open-spell-picker" data-tooltip="Browse official DCC Spells Compendium" style="color: #f1c40f; cursor: pointer; font-size: 13px; font-weight: normal; text-transform: none;">
          <i class="fa-solid fa-book-bookmark"></i> Spells Compendium
        </a>
        <a class="item-create" data-type="spell" data-tooltip="Create a custom spell" style="color: #fff; cursor: pointer; font-size: 13px; font-weight: normal; text-transform: none;">
          <i class="fa-solid fa-plus"></i> Custom Spell
        </a>
      </div>
    </div>

    <table class="dcc-attacks-table dcc-spells-table">
      <thead>
        <tr>
          <th style="width: 20%;">Spell Name</th>
          <th style="width: 5%; text-align: center;" title="Spell Rank">Rank</th>
          <th style="width: 7%; text-align: center;" title="Mana Cost">Mana</th>
          <th style="width: 10%;">Stat & Mod</th>
          <th style="width: 10%;">Range</th>
          <th style="width: 10%;">Duration</th>
          <th style="width: 13%;">Damage / Effect</th>
          <th style="width: 12%;">Notes / Upgrades</th>
          <th style="width: 13%; text-align: center;">Actions</th>
        </tr>
      </thead>
      <tbody>
        {{#each spells as |spell|}}
          <tr data-item-id="{{spell.id}}" draggable="true">
            <td>
              <div style="display: flex; align-items: center; gap: 6px;">
                <img src="{{spell.img}}" style="width: 22px; height: 22px; border: 1px solid #333; border-radius: 3px; object-fit: contain; background: #222;" />
                <input class="dcc-field-input item-inline-edit" type="text" data-field="name" value="{{spell.name}}" style="font-weight: bold; flex: 1;" />
                {{#if spell.system.spellType}}
                  <span class="dcc-badge" style="background: #2980b9; color: #fff; font-size: 9px; padding: 1px 4px; border-radius: 2px;" title="Spell Type: {{spell.system.spellType}}">{{upper spell.system.spellType}}</span>
                {{/if}}
              </div>
            </td>
            <td style="text-align: center;">
              <input class="dcc-stat-input item-inline-edit" type="number" data-field="system.rank" value="{{spell.system.rank}}" style="width: 32px; text-align: center;" title="Spell Rank" />
            </td>
            <td style="text-align: center;">
              <div style="display: inline-flex; align-items: center; justify-content: center; gap: 2px;">
                <input class="dcc-stat-input item-inline-edit" type="number" data-field="system.manaCost" value="{{spell.system.manaCost}}" style="width: 36px; text-align: center; color: #2980b9; font-weight: bold;" title="Mana Cost" />
                <span style="font-size: 10px; color: #7f8c8d;">MP</span>
              </div>
            </td>
            <td>
              <div style="display: flex; align-items: center; gap: 4px;">
                <select class="item-inline-edit" data-field="system.stat" style="font-family: 'Oswald', sans-serif; font-size: 11px;">
                  <option value="int" {{#if (eq spell.system.stat "int")}}selected{{/if}}>INT</option>
                  <option value="cha" {{#if (eq spell.system.stat "cha")}}selected{{/if}}>CHA</option>
                  <option value="str" {{#if (eq spell.system.stat "str")}}selected{{/if}}>STR</option>
                  <option value="con" {{#if (eq spell.system.stat "con")}}selected{{/if}}>CON</option>
                  <option value="dex" {{#if (eq spell.system.stat "dex")}}selected{{/if}}>DEX</option>
                </select>
                <span style="font-size: 11px; font-weight: bold; color: #c0392b;" title="{{upper spell.system.stat}} Stat Mod: {{spell.statModStr}}">{{spell.statModStr}}</span>
              </div>
            </td>
            <td>
              <input class="dcc-field-input item-inline-edit" type="text" data-field="system.range" value="{{spell.system.range}}" placeholder="Range..." style="font-size: 11px;" />
            </td>
            <td>
              <input class="dcc-field-input item-inline-edit" type="text" data-field="system.duration" value="{{spell.system.duration}}" placeholder="Duration..." style="font-size: 11px;" />
            </td>
            <td>
              <input class="dcc-field-input item-inline-edit" type="text" data-field="system.baseDamage" value="{{spell.system.baseDamage}}" placeholder="Damage / Effect..." style="font-size: 11px; font-weight: bold;" />
            </td>
            <td>
              <input class="dcc-field-input item-inline-edit" type="text" data-field="system.notes" value="{{spell.system.notes}}" placeholder="Notes..." style="font-size: 11px;" title="{{spell.system.notes}}" />
            </td>
            <td style="text-align: center; white-space: nowrap;">
              <button type="button" class="dcc-attack-roll-btn roll-spell" data-tooltip="Cast Spell: {{spell.name}}" style="font-size: 10px; padding: 2px 6px;">
                <i class="fa-solid fa-wand-magic-sparkles"></i>
              </button>
              {{#if spell.hasDamage}}
                <button type="button" class="dcc-attack-roll-btn roll-spell-dmg" data-tooltip="Roll Damage ({{spell.damageFormula}})" style="font-size: 10px; padding: 2px 6px; margin-left: 2px; background: #c0392b; color: #fff;">
                  <i class="fa-solid fa-burst"></i>
                </button>
              {{/if}}
              {{#if spell.isAttack}}
                <button type="button" class="dcc-attack-roll-btn roll-spell-hit" data-tooltip="Roll Spell Attack (1d20 + Rank {{spell.system.rank}} + {{upper spell.system.stat}} Mod)" style="font-size: 10px; padding: 2px 6px; margin-left: 2px; background: #2980b9; color: #fff;">
                  <i class="fa-solid fa-crosshairs"></i>
                </button>
              {{/if}}
              <a class="item-edit" data-tooltip="Edit Spell Details & Upgrades" style="margin-left: 3px; font-size: 11px; cursor: pointer;"><i class="fa-solid fa-edit"></i></a>
              <a class="item-delete" data-tooltip="Delete Spell" style="margin-left: 3px; font-size: 11px; cursor: pointer; color: #c0392b;"><i class="fa-solid fa-trash"></i></a>
            </td>
          </tr>
        {{else}}
          <tr>
            <td colspan="9" style="text-align: center; color: #777; padding: 18px;">
              No spells known yet. Click <strong style="color: #f1c40f;">Spells Compendium</strong> above to browse and drag official DCC spells, or click <strong>+ Custom Spell</strong> to create your own.
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
