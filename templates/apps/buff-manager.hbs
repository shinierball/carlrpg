<div class="dcc-manager-container dcc-buff-manager" style="display: flex; flex-direction: column; height: 100%; font-family: 'Oswald', sans-serif;">
  {{!-- Top Header & Controls --}}
  <div class="dcc-manager-header" style="background: #111; color: #fff; padding: 10px 14px; border-bottom: 2px solid #c0392b;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
      <div style="display: flex; align-items: center; gap: 8px;">
        <i class="fa-solid fa-shield-virus" style="color: #e74c3c; font-size: 18px;"></i>
        <span style="font-size: 16px; font-weight: bold; letter-spacing: 0.5px;">DCC BUFF &amp; CONDITION LIBRARY</span>
      </div>
      {{#if actor}}
        <div style="font-size: 12px; color: #f1c40f;">
          Target Character: <strong>{{actor.name}}</strong>
          {{#if targetSlot}}
            <span style="color: #3498db; margin-left: 4px;">(Slot: {{upper targetSlot}})</span>
          {{/if}}
        </div>
      {{/if}}
    </div>

    {{!-- Search Input --}}
    <div style="position: relative; margin-bottom: 8px;">
      <input type="text" class="condition-search-input dcc-field-input" placeholder="Search conditions, debuffs, resistances, stat bonuses..." value="{{searchQuery}}" style="width: 100%; height: 30px; font-size: 12px; padding-right: 24px;" />
      {{#if searchQuery}}
        <a class="condition-search-clear" style="position: absolute; right: 8px; top: 6px; color: #999; cursor: pointer;"><i class="fa-solid fa-xmark"></i></a>
      {{/if}}
    </div>

    {{!-- Filter Tabs --}}
    <div style="display: flex; gap: 6px; flex-wrap: wrap;">
      <a class="condition-tab-pill {{#if (eq activeTab 'all')}}is-active{{/if}}" data-tab="all" style="padding: 2px 8px; border-radius: 3px; font-size: 11px; cursor: pointer; background: {{#if (eq activeTab 'all')}}#c0392b{{else}}#333{{/if}}; color: #fff;">
        All ({{counts.all}})
      </a>
      <a class="condition-tab-pill {{#if (eq activeTab 'buffs')}}is-active{{/if}}" data-tab="buffs" style="padding: 2px 8px; border-radius: 3px; font-size: 11px; cursor: pointer; background: {{#if (eq activeTab 'buffs')}}#c0392b{{else}}#333{{/if}}; color: #fff;">
        <i class="fa-solid fa-sparkles"></i> Buffs ({{counts.buffs}})
      </a>
      <a class="condition-tab-pill {{#if (eq activeTab 'debuffs')}}is-active{{/if}}" data-tab="debuffs" style="padding: 2px 8px; border-radius: 3px; font-size: 11px; cursor: pointer; background: {{#if (eq activeTab 'debuffs')}}#c0392b{{else}}#333{{/if}}; color: #fff;">
        <i class="fa-solid fa-skull"></i> Debuffs ({{counts.debuffs}})
      </a>
      <a class="condition-tab-pill {{#if (eq activeTab 'stat')}}is-active{{/if}}" data-tab="stat" style="padding: 2px 8px; border-radius: 3px; font-size: 11px; cursor: pointer; background: {{#if (eq activeTab 'stat')}}#c0392b{{else}}#333{{/if}}; color: #fff;">
        Stat Modifiers ({{counts.stat}})
      </a>
      <a class="condition-tab-pill {{#if (eq activeTab 'defense')}}is-active{{/if}}" data-tab="defense" style="padding: 2px 8px; border-radius: 3px; font-size: 11px; cursor: pointer; background: {{#if (eq activeTab 'defense')}}#c0392b{{else}}#333{{/if}}; color: #fff;">
        Defenses &amp; Temp HP ({{counts.defense}})
      </a>
    </div>
  </div>

  {{!-- Condition Cards Body --}}
  <div class="dcc-manager-body" style="flex: 1; overflow-y: auto; padding: 10px; background: #222; display: flex; flex-direction: column; gap: 8px;">
    {{#each conditions as |cond|}}
      <div class="dcc-condition-card-row" style="background: #2a2a2a; border: 1px solid #444; border-left: 4px solid {{#if cond.isBuff}}#27ae60{{else}}#c0392b{{/if}}; border-radius: 4px; padding: 8px 10px; color: #eee; display: flex; justify-content: space-between; align-items: center; gap: 8px;">
        <div style="display: flex; align-items: center; gap: 8px; flex: 1;">
          <img src="{{cond.img}}" style="width: 32px; height: 32px; border: 1px solid #000; border-radius: 3px; object-fit: contain; background: #111;" />
          <div>
            <div style="display: flex; align-items: center; gap: 6px;">
              <span style="font-size: 14px; font-weight: bold; color: #fff;">{{cond.name}}</span>
              <span class="dcc-badge {{#if cond.isBuff}}dcc-badge-spell{{else}}dcc-badge-attack{{/if}}" style="font-size: 9px; padding: 1px 4px;">
                {{upper cond.type}}
              </span>
              {{#if cond.system.severity}}
                <span class="dcc-badge {{#if (eq cond.system.severity 'Major')}}dcc-badge-attack{{else}}dcc-badge-item{{/if}}" style="font-size: 9px; padding: 1px 4px;">
                  {{upper cond.system.severity}}
                </span>
              {{/if}}
              {{#if cond.system.duration}}
                <span style="font-size: 10px; color: #aaa;">({{cond.system.duration}})</span>
              {{/if}}
            </div>
            <div style="font-size: 11px; color: #bbb; margin-top: 2px;">
              {{#if cond.summary}}
                <span style="color: {{#if cond.isBuff}}#2ecc71{{else}}#e74c3c{{/if}}; font-weight: bold;">{{cond.summary}}</span>
              {{/if}}
              {{#if cond.system.description}}
                <span style="color: #999; margin-left: 4px;">— {{cond.system.description}}</span>
              {{/if}}
            </div>
          </div>
        </div>

        <div>
          {{#if ../actor}}
            {{#if cond.isActive}}
              <span class="dcc-badge" style="background: #27ae60; color: #fff; font-size: 11px; padding: 4px 8px;">
                <i class="fa-solid fa-check"></i> Active
              </span>
            {{else}}
              <button type="button" class="btn-apply-condition dcc-btn" data-name="{{cond.name}}" data-type="{{cond.type}}" style="background: {{#if cond.isBuff}}#27ae60{{else}}#c0392b{{/if}}; color: #fff; font-size: 11px; padding: 4px 10px; border: 1px solid #111; border-radius: 3px; font-weight: bold; cursor: pointer;">
                <i class="fa-solid fa-plus"></i> Apply
              </button>
            {{/if}}
          {{/if}}
        </div>
      </div>
    {{else}}
      <div style="text-align: center; color: #777; padding: 40px; font-size: 14px;">
        No buffs or conditions match the search criteria.
      </div>
    {{/each}}
  </div>
</div>
