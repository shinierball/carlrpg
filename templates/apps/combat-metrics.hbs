<form class="dcc-combat-metrics-form" autocomplete="off">
  {{!-- TOP CONTROLS BAR --}}
  <div class="dcc-metrics-header-bar">
    <div class="dcc-metrics-title-group">
      <i class="fa-solid fa-trophy dcc-trophy-icon"></i>
      <div>
        <h2 class="dcc-metrics-main-title">COMBAT PERFORMANCE & AI AWARDS</h2>
        <span class="dcc-metrics-subtitle">Dungeon Crawler Performance Analysis • Real Damage Tracking</span>
      </div>
    </div>

    <div class="dcc-metrics-controls">
      {{#if allCombats.length}}
        <div class="dcc-metrics-combat-select-wrapper">
          <label><i class="fa-solid fa-swords"></i> Encounter:</label>
          <select class="dcc-combat-select">
            {{#each allCombats}}
              <option value="{{this.id}}" {{#if (eq this.id ../selectedCombatId)}}selected{{/if}}>
                {{this.name}}{{#if this.isActive}} ★{{/if}}
              </option>
            {{/each}}
          </select>
        </div>
      {{/if}}

      {{#if hasCombat}}
        <button type="button" class="dcc-reset-metrics-btn" title="Reset all tracked metrics for this encounter">
          <i class="fa-solid fa-rotate-left"></i> Reset
        </button>
      {{/if}}
    </div>
  </div>

  {{!-- MAIN CONTENT AREA --}}
  <div class="dcc-metrics-body">
    {{#if hasCombat}}
      {{#if hasCrawlers}}
        <div class="dcc-crawler-metrics-grid">
          {{#each crawlers}}
            <div class="dcc-crawler-card" data-actor-id="{{this.actorId}}">
              {{!-- Card Header --}}
              <div class="dcc-crawler-card-header">
                <img class="dcc-crawler-avatar" src="{{this.img}}" alt="{{this.name}}" />
                <div class="dcc-crawler-info">
                  <h3 class="dcc-crawler-name">{{this.name}}</h3>
                  <div class="dcc-crawler-meta">
                    <span class="dcc-badge-level">Lv. {{this.level}} {{this.type}}</span>
                    <span class="dcc-badge-favor" title="Current AI Favor"><i class="fa-solid fa-hand-holding-heart"></i> Favor: {{this.aiFavor}}</span>
                  </div>
                </div>
                <div class="dcc-crawler-stat-banner">
                  <div class="dcc-stat-box dcc-stat-damage">
                    <span class="dcc-stat-number">{{this.totalDamage}}</span>
                    <span class="dcc-stat-label">Net Damage</span>
                  </div>
                </div>
              </div>

              {{!-- Key Performance Indicators --}}
              <div class="dcc-kpi-row">
                <div class="dcc-kpi-pill" title="Highest single attack damage dealt">
                  <i class="fa-solid fa-burst" style="color: #e67e22;"></i>
                  <span>Peak Hit: <strong>{{this.highestHit}}</strong></span>
                </div>
                <div class="dcc-kpi-pill" title="Enemies finished off (HP reduced to 0)">
                  <i class="fa-solid fa-skull" style="color: #c0392b;"></i>
                  <span>Kills: <strong>{{this.kills}}</strong></span>
                </div>
                <button type="button" class="dcc-adjust-damage-btn" data-actor-id="{{this.actorId}}" title="Manually adjust damage total">
                  <i class="fa-solid fa-pen-to-square"></i> Adjust
                </button>
              </div>

              {{!-- Attacks Breakdown Table --}}
              <div class="dcc-metrics-attacks-section">
                <h4 class="dcc-section-label"><i class="fa-solid fa-hand-fist"></i> Applied Attacks</h4>
                {{#if this.hasAttacks}}
                  <table class="dcc-metrics-attacks-table">
                    <thead>
                      <tr>
                        <th>Attack</th>
                        <th>Type</th>
                        <th style="text-align: center;">Hits</th>
                        <th style="text-align: right;">Total Dmg</th>
                        <th style="text-align: right;">Avg</th>
                      </tr>
                    </thead>
                    <tbody>
                      {{#each this.attacks}}
                        <tr>
                          <td class="dcc-attack-name"><strong>{{this.name}}</strong></td>
                          <td><span class="dcc-attack-type-tag">{{this.type}}</span></td>
                          <td style="text-align: center;">{{this.count}}</td>
                          <td style="text-align: right; color: #c0392b; font-weight: bold;">{{this.damage}}</td>
                          <td style="text-align: right; color: #7f8c8d;">{{this.avg}}</td>
                        </tr>
                      {{/each}}
                    </tbody>
                  </table>
                {{else}}
                  <div class="dcc-empty-hint">No attack damage applied yet in this combat.</div>
                {{/if}}
              </div>

              {{!-- Tactical Skills Section --}}
              <div class="dcc-skills-section">
                <h4 class="dcc-section-label"><i class="fa-solid fa-bolt"></i> Tactical Skills Used</h4>
                {{#if this.hasSkills}}
                  <div class="dcc-skills-badge-list">
                    {{#each this.skills}}
                      <span class="dcc-skill-pill">
                        <strong>{{this.name}}</strong> <span class="dcc-skill-count">×{{this.count}}</span>
                      </span>
                    {{/each}}
                  </div>
                {{else}}
                  <div class="dcc-empty-hint">No tactical skills rolled in this combat yet.</div>
                {{/if}}
              </div>
            </div>
          {{/each}}
        </div>
      {{else}}
        <div class="dcc-empty-state">
          <i class="fa-solid fa-users-slash"></i>
          <p>No combatants found in this encounter.</p>
        </div>
      {{/if}}
    {{else}}
      <div class="dcc-empty-state">
        <i class="fa-solid fa-swords"></i>
        <h3>NO ACTIVE COMBAT ENCOUNTER</h3>
        <p>Start an encounter in Foundry's Combat Tracker to track crawler damage and skill performance!</p>
      </div>
    {{/if}}
  </div>

  {{!-- AI AWARDS DISPATCH CONSOLE --}}
  <div class="dcc-awards-console">
    <div class="dcc-awards-header">
      <i class="fa-solid fa-bullhorn" style="color: #e74c3c;"></i>
      <span>THE DUNGEON AI AWARD CONSOLE</span>
    </div>

    <div class="dcc-awards-form-grid">
      {{!-- Crawler Selector --}}
      <div class="dcc-form-group">
        <label>Recipient:</label>
        <select class="dcc-award-recipient-select">
          {{#each crawlers}}
            <option value="{{this.actorId}}">{{this.name}} ({{this.totalDamage}} dmg)</option>
          {{/each}}
        </select>
      </div>

      {{!-- Award Type --}}
      <div class="dcc-form-group">
        <label>Award / Box:</label>
        <select class="dcc-award-type-select">
          <option value="bronze">Bronze Loot Box</option>
          <option value="silver">Silver Loot Box</option>
          <option value="gold">Gold Loot Box</option>
          <option value="platinum">Platinum Loot Box</option>
          <option value="legendary">Legendary Loot Box</option>
          <option value="celestial">Celestial Boss Loot Box</option>
          <option value="favor">AI Favor (+Favor)</option>
          <option value="mvp">Floor Combat MVP</option>
          <option value="custom">Custom Achievement</option>
        </select>
      </div>

      {{!-- Favor Delta (hidden by default unless favor selected) --}}
      <div class="dcc-form-group dcc-award-favor-group" style="display: none; max-width: 90px;">
        <label>Favor +:</label>
        <input type="number" class="dcc-award-favor-input" value="5" min="1" max="100" />
      </div>

      {{!-- Custom Flavor Voice Line --}}
      <div class="dcc-form-group dcc-form-quote-group">
        <label>AI Voice Line (Optional):</label>
        <input type="text" class="dcc-award-quote-input" placeholder="Leave blank for AI-generated commentary..." />
      </div>

      {{!-- Dispatch Button --}}
      <div class="dcc-form-group dcc-form-btn-group">
        <button type="button" class="dcc-dispatch-award-btn" title="Dispatch award to chat and update actor stats">
          <i class="fa-solid fa-paper-plane"></i> DISPATCH AWARD
        </button>
      </div>
    </div>
  </div>
</form>
