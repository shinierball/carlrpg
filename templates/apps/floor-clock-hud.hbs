<div id="dcc-floor-clock-hud" class="dcc-floor-clock-hud {{#if isCollapsed}}collapsed{{/if}}" data-tooltip="Floor Collapse Timer Clock">
  {{#if isCollapsed}}
    <div class="dcc-hud-pill-collapsed" style="display: flex; align-items: center; gap: 6px; padding: 3px 8px;">
      <button type="button" class="dcc-floor-hud-toggle-btn" title="Floor Timer Clock: {{floorTimer}} Hours Remaining. Click to expand." style="background: none; border: none; color: #fff; cursor: pointer; display: flex; align-items: center; gap: 5px; font-family: 'Oswald', sans-serif; font-size: 13px; padding: 0;">
        <i class="fa-solid fa-hourglass-half fa-spin-pulse" style="--fa-animation-duration: 4s; color: #e67e22;"></i>
        <span class="dcc-hud-collapsed-val" style="font-weight: bold; color: #f39c12;">{{floorTimer}}h</span>
      </button>
    </div>
  {{else}}
    <div class="dcc-floor-hud-inner">
      <div class="dcc-floor-hud-icon-wrap" title="Floor Collapse Clock">
        <i class="fa-solid fa-hourglass-half fa-spin-pulse" style="--fa-animation-duration: 4s; color: #e67e22; font-size: 15px;"></i>
      </div>
      <div class="dcc-floor-hud-body">
        <div class="dcc-floor-hud-title">
          <span class="dcc-hud-floor-badge">Floor {{currentFloor}}</span>
          <span class="dcc-hud-label">Collapse Clock</span>
        </div>
        <div class="dcc-floor-hud-time-row">
          {{#if isGM}}
            <button type="button" class="dcc-hud-adj-btn" data-delta="-5" title="Subtract 5 Hours">-5h</button>
            <button type="button" class="dcc-hud-adj-btn" data-delta="-1" title="Subtract 1 Hour">-1h</button>
            <input type="number" class="dcc-hud-time-input" value="{{floorTimer}}" min="0" title="Edit Floor Timer (Hours). Press Enter to save." />
            <button type="button" class="dcc-hud-adj-btn" data-delta="1" title="Add 1 Hour">+1h</button>
            <button type="button" class="dcc-hud-adj-btn" data-delta="5" title="Add 5 Hours">+5h</button>
          {{else}}
            <span class="dcc-hud-time-display">{{floorTimer}} <small>HRS</small></span>
          {{/if}}
        </div>
      </div>
      <div class="dcc-floor-hud-actions">
        <button type="button" class="dcc-floor-hud-collapse-btn" title="Minimize Clock HUD">
          <i class="fa-solid fa-chevron-up"></i>
        </button>
      </div>
    </div>
  {{/if}}
</div>
