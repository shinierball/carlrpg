<form class="{{cssClass}} dcc-item-sheet" autocomplete="off">
  <header class="dcc-item-header">
    <img src="{{item.img}}" data-edit="img" title="{{item.name}}" style="width: 56px; height: 56px; border: 2px solid #000; margin-right: 10px;" />
    <div style="flex: 1;">
      <h1 style="margin: 0; padding: 0; border: none;">
        <input name="name" type="text" value="{{item.name}}" placeholder="Item Name" class="dcc-field-input" style="font-size: 18px; font-weight: bold;" />
      </h1>
      <div style="font-family: 'Oswald', sans-serif; font-size: 12px; text-transform: uppercase; color: #e74c3c; margin-top: 4px;">
        Type: {{upper item.type}}
      </div>
    </div>
  </header>

  <div class="dcc-item-body" style="padding: 10px; background: #fff; border: 2px solid #000; margin-top: 10px;">
    {{!-- SKILL TYPE --}}
    {{#if (eq item.type "skill")}}
      <div class="dcc-field-row" style="margin-bottom: 8px; flex-wrap: wrap;">
        <div class="dcc-field-group small">
          <span class="dcc-field-label">Base Rank</span>
          <input class="dcc-field-input" type="number" name="system.rank" value="{{system.rank}}" />
        </div>
        <div class="dcc-field-group small">
          <span class="dcc-field-label">Boon Bonus</span>
          <input class="dcc-field-input" type="number" name="system.boonBonus" value="{{system.boonBonus}}" placeholder="0" />
        </div>
        <div class="dcc-field-group small">
          <span class="dcc-field-label">Item Bonus</span>
          <input class="dcc-field-input" type="number" name="system.itemBonus" value="{{system.itemBonus}}" placeholder="0" readonly title="Calculated from equipped gear" />
        </div>
        <div class="dcc-field-group small">
          <span class="dcc-field-label">Modified Rank</span>
          <input class="dcc-field-input" type="number" value="{{system.modifiedRank}}" readonly title="Base + Boon + Item Bonus" style="font-weight: bold; background: #fff8e7; color: #c0392b;" />
        </div>
        <div class="dcc-field-group small">
          <span class="dcc-field-label">Stat</span>
          <select name="system.stat" class="dcc-field-input">
            <option value="str" {{#if (eq system.stat "str")}}selected{{/if}}>STR</option>
            <option value="int" {{#if (eq system.stat "int")}}selected{{/if}}>INT</option>
            <option value="con" {{#if (eq system.stat "con")}}selected{{/if}}>CON</option>
            <option value="dex" {{#if (eq system.stat "dex")}}selected{{/if}}>DEX</option>
            <option value="cha" {{#if (eq system.stat "cha")}}selected{{/if}}>CHA</option>
          </select>
        </div>
        <div class="dcc-field-group">
          <span class="dcc-field-label">Check Type</span>
          <input class="dcc-field-input" type="text" name="system.checkType" value="{{system.checkType}}" placeholder="Stat Check" />
        </div>
      </div>
      <div class="dcc-field-group" style="margin-bottom: 8px;">
        <span class="dcc-field-label">Notes & Upgrades</span>
        <textarea class="dcc-field-input" name="system.notes" style="height: 120px;">{{system.notes}}</textarea>
      </div>
    {{/if}}

    {{!-- ATTACK TYPE --}}
    {{#if (eq item.type "attack")}}
      <div class="dcc-field-row" style="margin-bottom: 8px;">
        <div class="dcc-field-group small">
          <span class="dcc-field-label">To-Hit Rank</span>
          <input class="dcc-field-input" type="number" name="system.toHitRank" value="{{system.toHitRank}}" />
        </div>
        <div class="dcc-field-group small">
          <span class="dcc-field-label">To-Hit Stat</span>
          <select name="system.toHitStat" class="dcc-field-input">
            <option value="str" {{#if (eq system.toHitStat "str")}}selected{{/if}}>STR</option>
            <option value="dex" {{#if (eq system.toHitStat "dex")}}selected{{/if}}>DEX</option>
            <option value="con" {{#if (eq system.toHitStat "con")}}selected{{/if}}>CON</option>
            <option value="int" {{#if (eq system.toHitStat "int")}}selected{{/if}}>INT</option>
            <option value="cha" {{#if (eq system.toHitStat "cha")}}selected{{/if}}>CHA</option>
          </select>
        </div>
        <div class="dcc-field-group small">
          <span class="dcc-field-label">Damage Dice</span>
          <input class="dcc-field-input" type="text" name="system.damageDice" value="{{system.damageDice}}" placeholder="1d8" />
        </div>
        <div class="dcc-field-group small">
          <span class="dcc-field-label">Damage Stat</span>
          <select name="system.damageStat" class="dcc-field-input">
            <option value="str" {{#if (eq system.damageStat "str")}}selected{{/if}}>STR</option>
            <option value="dex" {{#if (eq system.damageStat "dex")}}selected{{/if}}>DEX</option>
            <option value="int" {{#if (eq system.damageStat "int")}}selected{{/if}}>INT</option>
            <option value="con" {{#if (eq system.damageStat "con")}}selected{{/if}}>CON</option>
            <option value="cha" {{#if (eq system.damageStat "cha")}}selected{{/if}}>CHA</option>
          </select>
        </div>
      </div>
      <div class="dcc-field-group">
        <span class="dcc-field-label">Effects</span>
        <input class="dcc-field-input" type="text" name="system.effects" value="{{system.effects}}" placeholder="Knockdown, Fire, Piercing..." />
      </div>
    {{/if}}

    {{!-- SPELL TYPE --}}
    {{#if (eq item.type "spell")}}
      {{#if system.quote}}
        <div class="dcc-spell-quote-box" style="background: #1a1a2e; color: #f1c40f; font-style: italic; padding: 8px 12px; border-left: 4px solid #e74c3c; border-radius: 4px; margin-bottom: 10px; font-size: 13px; font-family: 'Gelasio', Georgia, serif;">
          “{{system.quote}}”
        </div>
      {{/if}}

      <div class="dcc-field-row" style="margin-bottom: 8px; flex-wrap: wrap;">
        <div class="dcc-field-group small">
          <span class="dcc-field-label">Mana Cost</span>
          <input class="dcc-field-input" type="number" name="system.manaCost" value="{{system.manaCost}}" style="font-weight: bold; color: #2980b9;" />
        </div>
        <div class="dcc-field-group small">
          <span class="dcc-field-label">Range</span>
          <input class="dcc-field-input" type="text" name="system.range" value="{{system.range}}" placeholder="30 feet" />
        </div>
        <div class="dcc-field-group small">
          <span class="dcc-field-label">Duration</span>
          <input class="dcc-field-input" type="text" name="system.duration" value="{{system.duration}}" placeholder="Instantaneous" />
        </div>
        <div class="dcc-field-group small">
          <span class="dcc-field-label">Cooldown</span>
          <input class="dcc-field-input" type="text" name="system.cooldown" value="{{system.cooldown}}" placeholder="None" />
        </div>
        <div class="dcc-field-group small">
          <span class="dcc-field-label">AI Favor</span>
          <input class="dcc-field-input" type="number" name="system.aiFavor" value="{{system.aiFavor}}" placeholder="0" style="color: #e67e22;" />
        </div>
      </div>

      <div class="dcc-field-row" style="margin-bottom: 8px; flex-wrap: wrap;">
        <div class="dcc-field-group small">
          <span class="dcc-field-label">Spell Type</span>
          <input class="dcc-field-input" type="text" name="system.spellType" value="{{system.spellType}}" placeholder="Attack, Passive, Heal" />
        </div>
        <div class="dcc-field-group small">
          <span class="dcc-field-label">Stat</span>
          <select name="system.stat" class="dcc-field-input">
            <option value="int" {{#if (eq system.stat "int")}}selected{{/if}}>INT</option>
            <option value="cha" {{#if (eq system.stat "cha")}}selected{{/if}}>CHA</option>
            <option value="con" {{#if (eq system.stat "con")}}selected{{/if}}>CON</option>
            <option value="str" {{#if (eq system.stat "str")}}selected{{/if}}>STR</option>
            <option value="dex" {{#if (eq system.stat "dex")}}selected{{/if}}>DEX</option>
          </select>
        </div>
        <div class="dcc-field-group small">
          <span class="dcc-field-label">Damage Type</span>
          <input class="dcc-field-input" type="text" name="system.damageType" value="{{system.damageType}}" placeholder="Fire, Ice, Necrotic..." />
        </div>
        <div class="dcc-field-group" style="flex: 2;">
          <span class="dcc-field-label">Base Damage / Formula</span>
          <input class="dcc-field-input" type="text" name="system.baseDamage" value="{{system.baseDamage}}" placeholder="1d12 + Int Fire" />
        </div>
      </div>

      <div class="dcc-field-row" style="margin-bottom: 8px; flex-wrap: wrap;">
        <div class="dcc-field-group" style="flex: 1;">
          <span class="dcc-field-label">Favored Class</span>
          <input class="dcc-field-input" type="text" name="system.favored" value="{{system.favored}}" placeholder="Mage, Cleric, Druid, Bard..." />
        </div>
        <div class="dcc-field-group" style="flex: 2;">
          <span class="dcc-field-label">Limitations</span>
          <input class="dcc-field-input" type="text" name="system.limitations" value="{{system.limitations}}" placeholder="None" />
        </div>
      </div>

      <div class="dcc-field-group" style="margin-bottom: 8px;">
        <span class="dcc-field-label">Effect Description</span>
        <textarea class="dcc-field-input" name="system.description" style="height: 90px;">{{system.description}}</textarea>
      </div>

      <div class="dcc-stat-block" style="background: #fdfbf7; border: 1px solid #d4af37; border-radius: 4px; padding: 8px; margin-bottom: 8px;">
        <div class="dcc-banner-header" style="font-size: 11px; margin-bottom: 6px;"><i class="fa-solid fa-arrow-up-right-dots"></i> SPELL UPGRADES</div>
        <div class="dcc-field-group" style="margin-bottom: 6px;">
          <span class="dcc-field-label" style="color: #27ae60; font-weight: bold;">Rank 5</span>
          <input class="dcc-field-input" type="text" name="system.upgrades.rank5" value="{{system.upgrades.rank5}}" placeholder="Rank 5 upgrade..." />
        </div>
        <div class="dcc-field-group" style="margin-bottom: 6px;">
          <span class="dcc-field-label" style="color: #2980b9; font-weight: bold;">Rank 10</span>
          <input class="dcc-field-input" type="text" name="system.upgrades.rank10" value="{{system.upgrades.rank10}}" placeholder="Rank 10 upgrade..." />
        </div>
        <div class="dcc-field-group">
          <span class="dcc-field-label" style="color: #8e44ad; font-weight: bold;">Rank 15</span>
          <input class="dcc-field-input" type="text" name="system.upgrades.rank15" value="{{system.upgrades.rank15}}" placeholder="Rank 15 upgrade..." />
        </div>
      </div>

      <button type="button" class="dcc-btn roll-spell" style="width: 100%; background: #2c3e50; color: #fff; border: 2px solid #000; padding: 6px; font-weight: bold; cursor: pointer; border-radius: 4px;">
        <i class="fa-solid fa-wand-magic-sparkles"></i> Cast Spell / Post to Chat
      </button>
      {{#if hasDamage}}
        <button type="button" class="dcc-btn roll-spell-dmg" style="width: 100%; margin-top: 6px; background: #c0392b; color: #fff; border: 2px solid #000; padding: 6px; font-weight: bold; cursor: pointer; border-radius: 4px;">
          <i class="fa-solid fa-burst"></i> Roll Spell Damage{{#if damageFormula}} ({{damageFormula}}){{/if}}
        </button>
      {{/if}}
    {{/if}}

    {{!-- GEAR TYPE --}}
    {{#if (eq item.type "gear")}}
      <div class="dcc-field-row" style="margin-bottom: 8px; align-items: center;">
        <div class="dcc-field-group">
          <span class="dcc-field-label">Slot</span>
          <select name="system.slot" class="dcc-field-input">
            <option value="head" {{#if (eq system.slot "head")}}selected{{/if}}>Head</option>
            <option value="torso" {{#if (eq system.slot "torso")}}selected{{/if}}>Torso</option>
            <option value="arms" {{#if (eq system.slot "arms")}}selected{{/if}}>Arms</option>
            <option value="hands" {{#if (eq system.slot "hands")}}selected{{/if}}>Hands/Holding</option>
            <option value="legs" {{#if (eq system.slot "legs")}}selected{{/if}}>Legs</option>
            <option value="feet" {{#if (eq system.slot "feet")}}selected{{/if}}>Feet</option>
            <option value="accessory" {{#if (eq system.slot "accessory")}}selected{{/if}}>Accessory</option>
            <option value="tattoo" {{#if (eq system.slot "tattoo")}}selected{{/if}}>Tattoo</option>
            <option value="patch" {{#if (eq system.slot "patch")}}selected{{/if}}>Patch</option>
          </select>
        </div>
        <div class="dcc-field-group small" style="text-align: center;">
          <span class="dcc-field-label">Equipped</span>
          <label style="display: flex; align-items: center; justify-content: center; height: 28px; cursor: pointer;">
            <input type="checkbox" name="system.equipped" {{#if system.equipped}}checked{{/if}} style="width: 18px; height: 18px; cursor: pointer;" />
          </label>
        </div>
        <div class="dcc-field-group small">
          <span class="dcc-field-label">Damage Resist (DR)</span>
          <input class="dcc-field-input" type="number" name="system.drBonus" value="{{system.drBonus}}" placeholder="0" title="DR bonus or penalty (+/-)" />
        </div>
        <div class="dcc-field-group small">
          <span class="dcc-field-label">Evade Bonus</span>
          <input class="dcc-field-input" type="number" name="system.evadeBonus" value="{{system.evadeBonus}}" placeholder="0" />
        </div>
        <div class="dcc-field-group small">
          <span class="dcc-field-label">Quantity</span>
          <input class="dcc-field-input" type="number" name="system.quantity" value="{{system.quantity}}" />
        </div>
      </div>

      {{!-- STAT MODIFIERS (FLAT VS %) --}}
      <div class="dcc-stat-block" style="margin-bottom: 10px;">
        <div class="dcc-banner-header" style="font-size: 11px; padding: 3px 6px;">ABILITY MODIFIERS (EQUIPPED ONLY)</div>
        <table class="dcc-table" style="margin: 0; font-size: 11px;">
          <thead>
            <tr>
              <th style="width: 25%;">Ability</th>
              <th style="width: 35%;">Modifier Value (+/-)</th>
              <th style="width: 40%;">Type (Flat vs %)</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td style="font-weight: bold; color: #c0392b;">STR (Strength)</td>
              <td>
                <input class="dcc-field-input" type="number" name="system.abilityModifiers.str.value" value="{{system.abilityModifiers.str.value}}" placeholder="0" style="text-align: center;" />
              </td>
              <td>
                <select class="dcc-field-input" name="system.abilityModifiers.str.type">
                  <option value="flat" {{#if (or (eq system.abilityModifiers.str.type "flat") (not system.abilityModifiers.str.type))}}selected{{/if}}>Flat</option>
                  <option value="pct" {{#if (eq system.abilityModifiers.str.type "pct")}}selected{{/if}}>%</option>
                </select>
              </td>
            </tr>
            <tr>
              <td style="font-weight: bold; color: #c0392b;">INT (Intelligence)</td>
              <td>
                <input class="dcc-field-input" type="number" name="system.abilityModifiers.int.value" value="{{system.abilityModifiers.int.value}}" placeholder="0" style="text-align: center;" />
              </td>
              <td>
                <select class="dcc-field-input" name="system.abilityModifiers.int.type">
                  <option value="flat" {{#if (or (eq system.abilityModifiers.int.type "flat") (not system.abilityModifiers.int.type))}}selected{{/if}}>Flat</option>
                  <option value="pct" {{#if (eq system.abilityModifiers.int.type "pct")}}selected{{/if}}>%</option>
                </select>
              </td>
            </tr>
            <tr>
              <td style="font-weight: bold; color: #c0392b;">CON (Constitution)</td>
              <td>
                <input class="dcc-field-input" type="number" name="system.abilityModifiers.con.value" value="{{system.abilityModifiers.con.value}}" placeholder="0" style="text-align: center;" />
              </td>
              <td>
                <select class="dcc-field-input" name="system.abilityModifiers.con.type">
                  <option value="flat" {{#if (or (eq system.abilityModifiers.con.type "flat") (not system.abilityModifiers.con.type))}}selected{{/if}}>Flat</option>
                  <option value="pct" {{#if (eq system.abilityModifiers.con.type "pct")}}selected{{/if}}>%</option>
                </select>
              </td>
            </tr>
            <tr>
              <td style="font-weight: bold; color: #c0392b;">DEX (Dexterity)</td>
              <td>
                <input class="dcc-field-input" type="number" name="system.abilityModifiers.dex.value" value="{{system.abilityModifiers.dex.value}}" placeholder="0" style="text-align: center;" />
              </td>
              <td>
                <select class="dcc-field-input" name="system.abilityModifiers.dex.type">
                  <option value="flat" {{#if (or (eq system.abilityModifiers.dex.type "flat") (not system.abilityModifiers.dex.type))}}selected{{/if}}>Flat</option>
                  <option value="pct" {{#if (eq system.abilityModifiers.dex.type "pct")}}selected{{/if}}>%</option>
                </select>
              </td>
            </tr>
            <tr>
              <td style="font-weight: bold; color: #c0392b;">CHA (Charisma)</td>
              <td>
                <input class="dcc-field-input" type="number" name="system.abilityModifiers.cha.value" value="{{system.abilityModifiers.cha.value}}" placeholder="0" style="text-align: center;" />
              </td>
              <td>
                <select class="dcc-field-input" name="system.abilityModifiers.cha.type">
                  <option value="flat" {{#if (or (eq system.abilityModifiers.cha.type "flat") (not system.abilityModifiers.cha.type))}}selected{{/if}}>Flat</option>
                  <option value="pct" {{#if (eq system.abilityModifiers.cha.type "pct")}}selected{{/if}}>%</option>
                </select>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      {{!-- SKILL / SPELL MODIFIERS --}}
      <div class="dcc-stat-block" style="margin-bottom: 10px;">
        <div class="dcc-banner-header" style="font-size: 11px; padding: 3px 6px; display: flex; justify-content: space-between; align-items: center;">
          <span>
            SKILL & SPELL MODIFIERS / GRANTED SKILLS
            {{#if system.equipped}}
              <span style="color: #2ecc71; font-weight: bold; font-size: 10px; margin-left: 6px;">[EQUIPPED: ACTIVE]</span>
            {{else}}
              <span style="color: #f39c12; font-weight: bold; font-size: 10px; margin-left: 6px;" title="Equip this gear on the actor to activate skill bonuses">[UNEQUIPPED: EQUIP TO ACTIVATE]</span>
            {{/if}}
          </span>
          <a class="add-skill-mod" data-tooltip="Select and add skills from DCC Compendium" style="color: #fff; font-size: 10px; cursor: pointer;">
            <i class="fa-solid fa-book-bookmark"></i> Add Skill from Compendium
          </a>
        </div>
        <div style="padding: 6px; background: #fafafa; border: 1px solid #ddd;">
          {{#if system.skillModifiers.length}}
            <table class="dcc-table" style="margin: 0; font-size: 11px;">
              <thead>
                <tr>
                  <th style="width: 65%;">Skill / Spell Name</th>
                  <th style="width: 25%;">Rank Bonus</th>
                  <th style="width: 10%;"></th>
                </tr>
              </thead>
              <tbody>
                {{#each system.skillModifiers as |mod idx|}}
                  <tr>
                    <td>
                      <div style="display: flex; align-items: center; gap: 4px;">
                        <input list="dcc-compendium-skills-datalist-{{../item.id}}" class="dcc-field-input" type="text" name="system.skillModifiers.{{idx}}.name" value="{{mod.name}}" placeholder="Select from compendium or type..." style="font-size: 11px; flex: 1;" />
                        <a class="pick-skill-for-row" data-index="{{idx}}" data-tooltip="Pick from Compendium" style="color: #555; cursor: pointer; padding: 2px 4px;"><i class="fa-solid fa-book-bookmark"></i></a>
                      </div>
                    </td>
                    <td>
                      <input class="dcc-stat-input" type="number" name="system.skillModifiers.{{idx}}.bonus" value="{{mod.bonus}}" placeholder="1" style="width: 100%; font-size: 11px;" />
                    </td>
                    <td style="text-align: center;">
                      <a class="delete-skill-mod" data-index="{{idx}}" data-tooltip="Delete" style="color: #c0392b; cursor: pointer;"><i class="fa-solid fa-trash"></i></a>
                    </td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          {{else}}
            <div style="text-align: center; font-style: italic; color: #777; font-size: 11px; padding: 6px;">
              No skill or spell modifiers. Click "Add Skill from Compendium" above to grant or boost a skill.
            </div>
          {{/if}}
        </div>
      </div>

      <datalist id="dcc-compendium-skills-datalist-{{item.id}}">
        {{#each availableSkills as |skill|}}
          <option value="{{skill.name}}">{{skill.system.category}} [{{upper skill.system.stat}}] - {{skill.system.checkType}}</option>
        {{/each}}
      </datalist>

      <div class="dcc-field-group">
        <span class="dcc-field-label">Notes & Description</span>
        <textarea class="dcc-field-input" name="system.notes" style="height: 80px;">{{system.notes}}</textarea>
      </div>
    {{/if}}

    {{!-- RACE & CLASS TYPE --}}
    {{#if (or (eq item.type "race") (eq item.type "class"))}}
      <div class="dcc-field-group" style="margin-bottom: 8px;">
        <span class="dcc-field-label">Abilities</span>
        <textarea class="dcc-field-input" name="system.abilities" style="height: 140px;">{{system.abilities}}</textarea>
      </div>
      <div class="dcc-field-group">
        <span class="dcc-field-label">Description & Lore</span>
        <textarea class="dcc-field-input" name="system.description" style="height: 100px;">{{system.description}}</textarea>
      </div>
    {{/if}}

    {{!-- DEITY TYPE --}}
    {{#if (eq item.type "deity")}}
      <div class="dcc-field-group" style="margin-bottom: 8px;">
        <span class="dcc-field-label">Boons & Perks</span>
        <textarea class="dcc-field-input" name="system.boons" style="height: 120px;">{{system.boons}}</textarea>
      </div>
      <div class="dcc-field-group">
        <span class="dcc-field-label">Description</span>
        <textarea class="dcc-field-input" name="system.description" style="height: 100px;">{{system.description}}</textarea>
      </div>
    {{/if}}

    {{!-- SPONSOR TYPE --}}
    {{#if (eq item.type "sponsor")}}
      <div class="dcc-field-group" style="margin-bottom: 8px;">
        <span class="dcc-field-label">Gifts & Conditions</span>
        <textarea class="dcc-field-input" name="system.gifts" style="height: 120px;">{{system.gifts}}</textarea>
      </div>
      <div class="dcc-field-group">
        <span class="dcc-field-label">Notes</span>
        <textarea class="dcc-field-input" name="system.notes" style="height: 100px;">{{system.notes}}</textarea>
      </div>
    {{/if}}

    {{!-- LOOT / GENERIC --}}
    {{#if (eq item.type "loot")}}
      <div class="dcc-field-row" style="margin-bottom: 8px;">
        <div class="dcc-field-group small">
          <span class="dcc-field-label">Quantity</span>
          <input class="dcc-field-input" type="number" name="system.quantity" value="{{system.quantity}}" />
        </div>
      </div>
      <div class="dcc-field-group">
        <span class="dcc-field-label">Notes</span>
        <textarea class="dcc-field-input" name="system.notes" style="height: 140px;">{{system.notes}}</textarea>
      </div>
    {{/if}}
  </div>
</form>
